# Copy this file to `.env` (same folder) and fill in your key.
# The key stays on the server; the browser never sees it.
OPENAI_API_KEY=sk-your-key-here

# Any model your OpenAI account can use. A "mini" model is fast and cheap for demos.
OPENAI_MODEL=gpt-5.4-mini

# For reasoning models: none | minimal | low | medium | high.
# "low" keeps answers fast. Delete the line if your model doesn't support it.
OPENAI_REASONING_EFFORT=low

# Saves AI answers to data/ai-cache.json and replays identical questions.
# Keep "on" for the demo (works even if the venue Wi-Fi drops after a rehearsal).
AI_CACHE=on

PORT=3001